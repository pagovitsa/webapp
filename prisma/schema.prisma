generator client {
  provider = "prisma-client"
  output = "../.generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "mysql"
}

model User {
  id              String    @id @db.VarChar(191)
  name            String    @db.VarChar(254)
  email           String    @unique @db.VarChar(254)
  emailVerified   Boolean   @default(false)
  image           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  username        String?   @unique @db.VarChar(30)
  displayUsername String?   @db.VarChar(30)
  firstName       String    @default("") @db.VarChar(100)
  lastName        String    @default("") @db.VarChar(100)
  sessions        Session[]
  accounts        Account[]
}

model Session {
  id        String   @id @db.VarChar(191)
  expiresAt DateTime
  token     String   @unique @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.VarChar(191)
  userAgent String?  @db.Text
  userId    String   @db.VarChar(191)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id                    String    @id @db.VarChar(191)
  accountId             String    @db.VarChar(191)
  providerId            String    @db.VarChar(191)
  userId                String    @db.VarChar(191)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @db.VarChar(191)
  identifier String   @db.VarChar(254)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

model RateLimit {
  id          String @id @db.VarChar(191)
  key         String @unique @db.VarChar(191)
  count       Int
  lastRequest BigInt
}
