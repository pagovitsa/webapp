# Αντέγραψε σε .env.local και συμπλήρωσε τιμές.
DATABASE_URL=mysql://webapp_dev:CHANGE_ME@127.0.0.1:13306/webapp_dev
# Ξεχωριστή βάση και χρήστης για browser tests. Το services:up δημιουργεί τις τοπικές τιμές.
TEST_DATABASE_URL=mysql://webapp_test:CHANGE_ME@127.0.0.1:13306/webapp_test
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# smtp://user:password@host:587 ή smtps://user:password@host:465
SMTP_URL=smtp://127.0.0.1:12525
SMTP_FROM=Webapp <no-reply@example.test>
LOG_LEVEL=info
