    "/api/auth/reset-password/{token}": {
      "get": {
        "operationId": "openPasswordReset",
        "summary": "Callback προς τη φόρμα νέου κωδικού",
        "security": [],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "callbackURL",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Ανακατεύθυνση στη φόρμα αλλαγής κωδικού."
          },
          "400": {
            "description": "Μη έγκυρος σύνδεσμος.",
            "content": {
