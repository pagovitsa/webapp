    "/api/auth/verify-email": {
      "get": {
        "operationId": "verifyEmail",
        "summary": "Callback από το email επιβεβαίωσης",
        "security": [],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "callbackURL",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Ανακατεύθυνση στη σελίδα σύνδεσης ή στο σφάλμα επιβεβαίωσης."
          },
          "400": {
            "description": "Μη έγκυρος σύνδεσμος.",
