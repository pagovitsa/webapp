{
  "openapi": "3.1.0",
  "info": {
    "title": "Webapp Users API",
    "version": "1.0.0",
    "description": "Cookie-based API για first-party clients του ίδιου origin. Οι συνεδρίες αποθηκεύονται στη βάση, χωρίς bearer/JWT session tokens. Σε HTTPS το cookie ονομάζεται __Secure-better-auth.session_token. Όλες οι μεταβολές ακολουθούν το HTTP middleware του Better Auth."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/auth/sign-up/email": {
      "post": {
        "operationId": "registerUser",
        "summary": "Ανοιχτή εγγραφή",
        "security": [],
        "description": "Same-origin JSON. Τα cookies αποθηκεύονται από τον client. Τα callback URLs ορίζονται από τον server.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Registration"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Επιτυχία. Η συνεδρία μεταφέρεται μόνο με HttpOnly cookie.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success"
                }
              }
            }
          },
          "400": {
            "description": "Μη έγκυρα στοιχεία.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Μη έμπιστο origin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Απαιτείται application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Υπέρβαση ορίου προσπαθειών.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Δευτερόλεπτα έως νέα προσπάθεια."
              }
            }
          },
          "503": {
            "description": "Προσωρινή αδυναμία υπηρεσίας.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
