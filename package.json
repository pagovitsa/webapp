{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^26.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test:tooling": "node --test \"tests/**/*.test.mjs\"",
    "test:unit": "vitest run",
    "test": "npm run test:unit && npm run test:tooling",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run arch && npm run test && npm run build",
    "module:new": "node scripts/new-module.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
